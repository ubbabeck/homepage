# Custom 404 Error Page
ErrorDocument 404 /404.html

# Enable RewriteEngine
RewriteEngine On

# Prevent access to hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow .well-known directory (needed for Nostr NIP-05)
<Directory ".well-known">
    Order allow,deny
    Allow from all
</Directory>
